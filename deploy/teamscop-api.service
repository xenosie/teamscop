[Unit]
Description=Teamscop API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=teamscop
Group=teamscop
WorkingDirectory=/opt/teamscop/api
EnvironmentFile=/etc/teamscop/api.env
ExecStart=/opt/teamscop/api/Teamscop.Api
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
