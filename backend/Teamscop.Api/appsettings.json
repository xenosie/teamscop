{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Port=5432;Database=teamscop;Username=teamscop;Password=CHANGE_ME"
  },
  "Jwt": {
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "teamscop",
    "Audience": "teamscop-agent",
    "AccessTokenMinutes": 0
  },
  "CompanyToken": {
    "Key": ""
  },
  "Crypto": {
    "_comment": "Key for AccessTotpSecret at rest. Empty falls back to Jwt:Key, which is how every deployment behaved before this option existed — but leaving it empty means rotating Jwt:Key destroys every stored approval secret irrecoverably. Set it to its own long random value.",
    "TotpSecretKey": ""
  },
  "Storage": {
    "AvatarRoot": "data/avatars",
    "PublicAvatarBasePath": "/api/media/avatars",
    "ScreenshotRoot": "data/screenshots"
  },
  "Retention": {
    "AgentEventsDays": 30
  },
  "Ingest": {
    "MaxBatchEvents": 200,
    "MaxPayloadChars": 2000000,
    "MaxBatchBytes": 8388608,
    "MaxRequestBodyBytes": 12582912
  },
  "Database": {
    "MigrateOnStartup": true
  }
}
