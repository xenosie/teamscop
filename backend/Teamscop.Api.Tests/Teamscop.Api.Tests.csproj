<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Teamscop.Api\Teamscop.Api.csproj" />
    <ProjectReference Include="..\..\agent\Teamscop.Engine.Auth\Teamscop.Engine.Auth.csproj" />
    <ProjectReference Include="..\..\agent\Teamscop.Engine.Lifecycle\Teamscop.Engine.Lifecycle.csproj" />
    <ProjectReference Include="..\..\agent\Teamscop.Engine.Sync\Teamscop.Engine.Sync.csproj" />
    <ProjectReference Include="..\..\agent\Teamscop.Engine.Tracking\Teamscop.Engine.Tracking.csproj" />
    <ProjectReference Include="..\..\agent\Teamscop.Engine.Usb\Teamscop.Engine.Usb.csproj" />

    <!--
      C2 — the service-side capture pipe (CapturePipeServer) lives here, and it is the process that
      per-staff config has to reach (§6.2). Its Program uses top-level statements, so the generated
      Program type is internal and cannot collide with Teamscop.Api's public partial Program used by
      WebApplicationFactory<Program>.
    -->
    <ProjectReference Include="..\..\agent\Teamscop.StaffService\Teamscop.StaffService.csproj" />
  </ItemGroup>

</Project>
