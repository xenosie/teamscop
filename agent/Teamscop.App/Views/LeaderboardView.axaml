<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Teamscop.App.ViewModels"
             xmlns:views="clr-namespace:Teamscop.App.Views"
             xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
             x:Class="Teamscop.App.Views.LeaderboardView"
             x:Name="BoardRoot"
             x:DataType="vm:LeaderboardViewModel">

  <Panel>
    <DockPanel Margin="28" LastChildFill="True">

      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
        <StackPanel Spacing="2">
          <TextBlock Text="Leaderboard"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TsTextBrush}" />
          <TextBlock Text="{Binding PeriodLabel}" Classes="ts-muted" FontSize="13" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="ts-toolbar"
                  Content="Refresh"
                  MinWidth="86"
                  Command="{Binding RefreshCommand}" />
          <!-- Any period, from the calendar (§14.3) — the same control the staff views use -->
          <Button Classes="ts-link"
                  Width="40" Height="40"
                  Padding="0"
                  Command="{Binding PeriodFilter.ToggleCalendarCommand}"
                  ToolTip.Tip="Choose the period">
            <heroIcons:HeroIcon Type="CalendarDays" Kind="Outline" Width="22" Height="22"
                                Foreground="{StaticResource TsAccentBrush}" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- Server-paged: "more" is the next page of the ranking, not more of a list already held. -->
      <Grid DockPanel.Dock="Bottom"
            ColumnDefinitions="*,Auto"
            Margin="0,10,0,0"
            IsVisible="{Binding IsPaged}">
        <TextBlock Text="{Binding PageLabel}"
                   Classes="ts-muted"
                   FontSize="12"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="ts-toolbar"
                Content="Show 25 more"
                IsVisible="{Binding HasMore}"
                IsEnabled="{Binding !IsLoading}"
                Command="{Binding ShowMoreCommand}" />
      </Grid>

      <Panel>
        <TextBlock Text="{Binding Problem}"
                   IsVisible="{Binding ShowProblem}"
                   Foreground="#B91C1C"
                   FontSize="13"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top" />
        <TextBlock Text="Loading…"
                   IsVisible="{Binding IsLoading}"
                   Classes="ts-muted"
                   FontSize="13"
                   VerticalAlignment="Top" />
        <TextBlock Text="Choose a period to rank staff by hours worked."
                   IsVisible="{Binding ShowEmpty}"
                   Classes="ts-muted"
                   FontSize="13"
                   VerticalAlignment="Top" />

        <DockPanel IsVisible="{Binding HasRows}" LastChildFill="True">
          <Grid DockPanel.Dock="Top"
                ColumnDefinitions="42,36,*,272,72"
                Margin="12,0,12,6">
            <TextBlock Text="#" Classes="ts-muted" FontSize="11" />
            <TextBlock Grid.Column="2" Text="Staff" Classes="ts-muted" FontSize="11" />
            <TextBlock Grid.Column="3" Text="Hours worked" Classes="ts-muted" FontSize="11" />
          </Grid>

          <!-- A ListBox purely for its VirtualizingStackPanel: rows and their avatars are only
               realised once they are on screen (§15.1). Selection is meaningless here. -->
          <ListBox Classes="ts-plain"
                   ItemsSource="{Binding Rows}"
                   SelectionMode="Single"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LeaderboardRowViewModel">
                  <Border BorderBrush="{StaticResource TsDividerBrush}"
                          BorderThickness="0,0,0,1"
                          Padding="12,9"
                          AttachedToVisualTree="OnRowAttached"
                          DataContextChanged="OnRowDataContextChanged">
                    <Grid ColumnDefinitions="42,36,*,272,72">
                      <TextBlock Text="{Binding Rank}"
                                 FontSize="14"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TsTextMutedBrush}"
                                 IsVisible="{Binding !IsPodium}" />
                      <TextBlock Text="{Binding Rank}"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource TsAccentBrush}"
                                 IsVisible="{Binding IsPodium}" />

                      <Border Grid.Column="1"
                              Width="28" Height="28"
                              Classes="ts-circle-avatar"
                              ClipToBounds="True"
                              VerticalAlignment="Center"
                              Background="{StaticResource TsAccentSoftBrush}">
                        <Panel>
                          <heroIcons:HeroIcon Type="User" Kind="Outline" Width="14" Height="14"
                                              Foreground="{StaticResource TsAccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding !HasAvatar}" />
                          <Image Source="{Binding Avatar}"
                                 Stretch="UniformToFill"
                                 IsVisible="{Binding HasAvatar}" />
                        </Panel>
                      </Border>

                      <TextBlock Grid.Column="2"
                                 Text="{Binding Name}"
                                 FontSize="13"
                                 FontWeight="Medium"
                                 Margin="10,0,12,0"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />

                      <Panel Grid.Column="3"
                             Width="260"
                             Height="10"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Background="#E2E8F0">
                        <Border Width="{Binding BarWidth}"
                                Height="10"
                                HorizontalAlignment="Left"
                                Background="{StaticResource TsAccentBrush}" />
                      </Panel>

                      <TextBlock Grid.Column="4"
                                 Text="{Binding WorkedLabel}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 TextAlignment="Right"
                                 VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Panel>
    </DockPanel>

    <Border HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,76,28,0"
            ZIndex="30"
            IsVisible="{Binding PeriodFilter.IsCalendarOpen}">
      <views:StaffPeriodCalendarView DataContext="{Binding PeriodFilter}" />
    </Border>
  </Panel>
</UserControl>
