<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Teamscop.App.ViewModels"
             xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
             x:Class="Teamscop.App.Views.TeamsBoardView"
             x:DataType="vm:TeamsBoardViewModel"
             Background="{StaticResource TsBackgroundBrush}">

  <DockPanel Margin="20,16">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Teams"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TsTextBrush}" />
        <TextBlock Text="{Binding StatusMessage}"
                   Classes="ts-muted"
                   FontSize="12"
                   VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="ts-primary"
              Content="New Team"
              MinWidth="120"
              Height="40"
              Command="{Binding CreateTeamCommand}" />
    </Grid>

    <ScrollViewer Classes="ts-transparent-scroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Teams}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TeamBoxViewModel">
            <Panel Margin="0,10,16,18" Width="240" MaxWidth="240">
              <Border Classes="ts-coolinput" Margin="0,8,0,0" MinHeight="140">
                <DockPanel>
                  <Button DockPanel.Dock="Top"
                          Classes="ts-link"
                          HorizontalAlignment="Right"
                          Padding="4"
                          Margin="0,0,0,4"
                          ToolTip.Tip="Remove team"
                          Tag="{Binding}"
                          Click="OnDeleteTeamClick">
                    <heroIcons:HeroIcon Type="Trash" Kind="Outline" Width="14" Height="14"
                                        Foreground="{StaticResource TsAccentBrush}" />
                  </Button>

                  <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                    <Button Classes="ts-toolbar"
                            Content="Add leader"
                            HorizontalAlignment="Stretch"
                            Height="34"
                            FontSize="12"
                            Tag="{Binding}"
                            IsVisible="{Binding HasNoLeader}"
                            Click="OnAddLeaderClick" />
                    <Button Classes="ts-toolbar"
                            Content="Add member"
                            HorizontalAlignment="Stretch"
                            Height="34"
                            FontSize="12"
                            Tag="{Binding}"
                            Click="OnAddMemberClick" />
                  </StackPanel>

                  <StackPanel Spacing="8">
                    <!-- Leader: larger row, no box -->
                    <Grid IsVisible="{Binding HasLeader}"
                          ColumnDefinitions="Auto,*,Auto,Auto"
                          MinHeight="40"
                          Margin="0,0,0,4">
                      <Border Width="36" Height="36"
                              Classes="ts-circle-avatar"
                              ClipToBounds="True"
                              Background="{StaticResource TsAccentSoftBrush}"
                              VerticalAlignment="Center">
                        <Panel>
                          <heroIcons:HeroIcon Type="User" Kind="Outline" Width="16" Height="16"
                                              Foreground="{StaticResource TsAccentBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsVisible="{Binding !Leader.HasAvatar}" />
                          <Image Source="{Binding Leader.Avatar}" Stretch="UniformToFill"
                                 IsVisible="{Binding Leader.HasAvatar}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="Leader"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TsAccentBrush}" />
                        <TextBlock Text="{Binding Leader.Name}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Column="2"
                              Classes="ts-link"
                              Padding="4"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Switch leader"
                              Tag="{Binding}"
                              Click="OnSwitchLeaderClick">
                        <heroIcons:HeroIcon Type="ArrowsRightLeft" Kind="Outline" Width="14" Height="14"
                                            Foreground="{StaticResource TsAccentBrush}" />
                      </Button>
                      <Button Grid.Column="3"
                              Classes="ts-link"
                              Content="✕"
                              FontSize="12"
                              Padding="4,0"
                              VerticalAlignment="Center"
                              Tag="{Binding Leader}"
                              Click="OnRemovePersonClick" />
                    </Grid>

                    <!-- Members -->
                    <ItemsControl ItemsSource="{Binding Members}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StaffCardViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto"
                                Margin="0,0,0,8"
                                MinHeight="30">
                            <Border Width="28" Height="28"
                                    Classes="ts-circle-avatar"
                                    ClipToBounds="True"
                                    Background="{StaticResource TsAccentSoftBrush}"
                                    VerticalAlignment="Center">
                              <Panel>
                                <heroIcons:HeroIcon Type="User" Kind="Outline" Width="13" Height="13"
                                                    Foreground="{StaticResource TsAccentBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding !HasAvatar}" />
                                <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                       IsVisible="{Binding HasAvatar}" />
                              </Panel>
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       Margin="8,0,8,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2"
                                    Classes="ts-link"
                                    Content="✕"
                                    FontSize="12"
                                    Padding="4,0"
                                    VerticalAlignment="Center"
                                    Tag="{Binding}"
                                    Click="OnRemovePersonClick" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DockPanel>
              </Border>

              <TextBox Text="{Binding Name}"
                       Classes="ts-coolinput-label"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Margin="10,0,0,0"
                       MinWidth="40"
                       MaxWidth="180"
                       Tag="{Binding}"
                       LostFocus="OnTeamNameLostFocus" />
            </Panel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
