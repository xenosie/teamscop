<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Teamscop.App.ViewModels"
             x:Class="Teamscop.App.Views.BrowsingHistoryView"
             x:DataType="vm:BrowsingHistoryViewModel">

  <DockPanel LastChildFill="True"
             HorizontalAlignment="Stretch">
    <StackPanel DockPanel.Dock="Top"
                Spacing="4"
                Margin="0,0,0,16"
                HorizontalAlignment="Left">
      <TextBlock Text="Browsing History"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TsTextBrush}"
                 HorizontalAlignment="Left" />
      <TextBlock Text="Unique sites in the selected period (subdomains rolled up), sorted by visit count."
                 FontSize="13"
                 Foreground="{StaticResource TsTextMutedBrush}"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Left"
                 MaxWidth="640" />
    </StackPanel>

    <Panel HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ShowError}"
                 Foreground="#B91C1C"
                 FontSize="13"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top" />
      <TextBlock Text="{Binding EmptyMessage}"
                 IsVisible="{Binding ShowEmpty}"
                 Foreground="{StaticResource TsTextMutedBrush}"
                 FontSize="13"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top" />
      <TextBlock Text="Loading…"
                 IsVisible="{Binding IsLoading}"
                 Foreground="{StaticResource TsTextMutedBrush}"
                 FontSize="13"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top" />

      <DockPanel IsVisible="{Binding HasItems}"
                 HorizontalAlignment="Left"
                 LastChildFill="True">
        <!-- A day of browsing is hundreds of domains: a page at a time (A14 / §15.1) -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,8,0,0"
                    IsVisible="{Binding IsPaged}">
          <TextBlock Text="{Binding PageLabel}"
                     Classes="ts-muted"
                     FontSize="12"
                     VerticalAlignment="Center" />
          <Button Classes="ts-link"
                  FontSize="12"
                  Content="Show 25 more"
                  IsVisible="{Binding HasMore}"
                  Command="{Binding ShowMoreCommand}" />
          <Button Classes="ts-link"
                  FontSize="12"
                  Content="Show all"
                  IsVisible="{Binding HasMore}"
                  Command="{Binding ShowAllCommand}" />
        </StackPanel>

        <!-- A ListBox purely for its VirtualizingStackPanel; selection is meaningless here. -->
        <ListBox Classes="ts-plain"
                 ItemsSource="{Binding Items}"
                 SelectionMode="Single"
                 Width="536"
                 HorizontalAlignment="Left"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BrowsingDomainRowViewModel">
              <Button Classes="ts-link"
                      HorizontalAlignment="Left"
                      HorizontalContentAlignment="Left"
                      Padding="0"
                      Margin="0,0,0,1"
                      Width="520"
                      Command="{Binding OpenCommand}">
                <Grid ColumnDefinitions="*,Auto" Margin="0,6" Width="520">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Domain}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TsTextBrush}"
                             TextAlignment="Left"
                             HorizontalAlignment="Left"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1"
                             Text="{Binding VisitCountLabel}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TsAccentBrush}"
                             Margin="16,0,0,0"
                             MinWidth="28"
                             TextAlignment="Right"
                             HorizontalAlignment="Right" />
                </Grid>
              </Button>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>
