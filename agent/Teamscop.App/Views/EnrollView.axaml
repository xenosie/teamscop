<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Teamscop.App.ViewModels"
             xmlns:controls="clr-namespace:Teamscop.App.Controls"
             xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
             x:Class="Teamscop.App.Views.EnrollView"
             x:DataType="vm:EnrollViewModel"
             Background="{StaticResource TsBackgroundBrush}">

  <Panel>
    <Grid ColumnDefinitions="*,Auto,*">
      <Panel Grid.Column="0" ClipToBounds="True">
        <Image Source="/Assets/auth-left-collab.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />
      </Panel>

      <Border Grid.Column="1"
              Width="1.5"
              Background="{StaticResource TsAccentBrush}"
              HorizontalAlignment="Center"
              VerticalAlignment="Stretch" />

      <Grid Grid.Column="2"
            Background="{StaticResource TsBackgroundBrush}"
            RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0"
              Height="48"
              ColumnDefinitions="*,*"
              Background="{StaticResource TsSurfaceBrush}">
          <Button Grid.Column="0"
                  Classes="ts-toolbar"
                  Classes.selected="{Binding IsCreateCompany}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  BorderThickness="0,0,1,1"
                  BorderBrush="{StaticResource TsAccentBrush}"
                  Command="{Binding SetModeCommand}"
                  CommandParameter="CreateCompany"
                  Content="Register Business"
                  FontWeight="SemiBold" />
          <Button Grid.Column="1"
                  Classes="ts-toolbar"
                  Classes.selected="{Binding IsJoinCompany}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  BorderThickness="0,0,0,1"
                  BorderBrush="{StaticResource TsAccentBrush}"
                  Command="{Binding SetModeCommand}"
                  CommandParameter="JoinCompany"
                  Content="Join Business"
                  FontWeight="SemiBold" />
        </Grid>

        <Panel Grid.Row="1">
          <!-- Register Business -->
          <ScrollViewer IsVisible="{Binding IsCreateCompany}"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="32,16">
            <StackPanel Spacing="12" HorizontalAlignment="Center" Width="380">
              <TextBlock Text="Register your business"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TsTextBrush}" />

              <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                <TextBlock Text="Business photo"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TsTextMutedBrush}"
                           HorizontalAlignment="Center" />
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <Button Classes="ts-photo"
                          Command="{Binding PickPhotoCommand}"
                          HorizontalAlignment="Center"
                          IsEnabled="{Binding !IsBusy}">
                    <Panel>
                      <heroIcons:HeroIcon Type="Photo" Kind="Outline" Width="28" Height="28"
                                          Foreground="{StaticResource TsAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding !HasAvatar}" />
                      <Image Source="{Binding AvatarPreview}"
                             Stretch="UniformToFill"
                             IsVisible="{Binding HasAvatar}" />
                    </Panel>
                  </Button>
                  <Button Classes="ts-link"
                          Content="Remove"
                          HorizontalAlignment="Center"
                          IsVisible="{Binding HasAvatar}"
                          Command="{Binding ClearPhotoCommand}"
                          Foreground="{StaticResource TsTextMutedBrush}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Business name"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TsTextMutedBrush}" />
                <TextBox Classes="ts-field"
                         Text="{Binding BusinessName, Mode=TwoWay}"
                         Watermark="e.g. Acme Business" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Admin password"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TsTextMutedBrush}" />
                <TextBox Classes="ts-field"
                         Text="{Binding Password, Mode=TwoWay}"
                         PasswordChar="•"
                         Watermark="Password" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Confirm password"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TsTextMutedBrush}" />
                <TextBox Classes="ts-field"
                         Text="{Binding PasswordConfirm, Mode=TwoWay}"
                         PasswordChar="•"
                         Watermark="Confirm password" />
              </StackPanel>

              <TextBlock Text="{Binding ErrorMessage}"
                         IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="#DC2626"
                         FontSize="13"
                         TextWrapping="Wrap" />

              <Button Classes="ts-primary"
                      Content="Create"
                      Command="{Binding CreateBusinessCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Height="44"
                      IsEnabled="{Binding !IsBusy}"
                      Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>

          <!-- Join Business -->
          <ScrollViewer IsVisible="{Binding IsJoinCompany}"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Padding="32,16">
            <!-- Width pinned: a pasted token of any length must never widen or reflow the form.
                 The field scrolls internally; the layout is a constant. -->
            <StackPanel Spacing="12" HorizontalAlignment="Center" Width="380">
              <TextBlock Text="Join a business"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TsTextBrush}" />

              <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                <TextBlock Text="Your photo"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TsTextMutedBrush}"
                           HorizontalAlignment="Center" />
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <Button Classes="ts-photo"
                          Command="{Binding PickPhotoCommand}"
                          HorizontalAlignment="Center"
                          IsEnabled="{Binding !IsBusy}">
                    <Panel>
                      <heroIcons:HeroIcon Type="Photo" Kind="Outline" Width="28" Height="28"
                                          Foreground="{StaticResource TsAccentBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          IsVisible="{Binding !HasAvatar}" />
                      <Image Source="{Binding AvatarPreview}"
                             Stretch="UniformToFill"
                             IsVisible="{Binding HasAvatar}" />
                    </Panel>
                  </Button>
                  <Button Classes="ts-link"
                          Content="Remove"
                          HorizontalAlignment="Center"
                          IsVisible="{Binding HasAvatar}"
                          Command="{Binding ClearPhotoCommand}"
                          Foreground="{StaticResource TsTextMutedBrush}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Your name"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TsTextMutedBrush}" />
                <TextBox Classes="ts-field"
                         Text="{Binding BusinessName, Mode=TwoWay}"
                         Watermark="e.g. Jane Doe" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Password"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TsTextMutedBrush}" />
                <TextBox Classes="ts-field"
                         Text="{Binding Password, Mode=TwoWay}"
                         PasswordChar="•"
                         Watermark="Password" />
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Confirm password"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TsTextMutedBrush}" />
                <TextBox Classes="ts-field"
                         Text="{Binding PasswordConfirm, Mode=TwoWay}"
                         PasswordChar="•"
                         Watermark="Confirm password" />
              </StackPanel>

              <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                <TextBlock Text="Business token"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TsAccentBrush}" />
                <!-- Fixed single-line field: long TS1 tokens must not grow the form or cover Join. -->
                <TextBox Classes="ts-field"
                         Text="{Binding CompanyTokenInput, Mode=TwoWay}"
                         Watermark="Paste business token"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         Height="44"
                         MinHeight="44"
                         MaxHeight="44"
                         HorizontalAlignment="Stretch"
                         ClipToBounds="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" />
              </StackPanel>

              <TextBlock Text="{Binding ErrorMessage}"
                         IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="#DC2626"
                         FontSize="13"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding InfoMessage}"
                         IsVisible="{Binding InfoMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                         Foreground="{StaticResource TsAccentBrush}"
                         FontSize="13"
                         TextWrapping="Wrap" />

              <Button Classes="ts-primary"
                      Content="Join"
                      Command="{Binding JoinBusinessCommand}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Height="44"
                      IsEnabled="{Binding !IsBusy}"
                      Margin="0,8,0,0" />
            </StackPanel>
          </ScrollViewer>
        </Panel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,16">
          <TextBlock Text="Already registered on this machine?"
                     Classes="ts-muted"
                     FontSize="12"
                     VerticalAlignment="Center" />
          <Button Classes="ts-link"
                  Content="Sign in"
                  FontSize="12"
                  Command="{Binding ShowSignInCommand}" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border IsVisible="{Binding IsBusy}"
            IsHitTestVisible="{Binding IsBusy}"
            Background="#80F8FAFC"
            ZIndex="20">
      <controls:TsSpinner HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <!-- Business token modal -->
    <Border IsVisible="{Binding ShowTokenModal}"
            IsHitTestVisible="{Binding ShowTokenModal}"
            Background="#990F172A"
            ZIndex="30">
      <Border Background="{StaticResource TsSurfaceBrush}"
              BorderBrush="{StaticResource TsAccentBrush}"
              BorderThickness="1"
              Width="420"
              Padding="28,26"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="36" Height="36" Background="{StaticResource TsAccentBrush}">
              <heroIcons:HeroIcon Type="ShieldCheck" Kind="Solid" Width="20" Height="20"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Business created"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TsTextBrush}" />
              <TextBlock Classes="ts-muted"
                         FontSize="12"
                         Text="Save this token — staff need it to join." />
            </StackPanel>
          </StackPanel>

          <TextBlock Text="Business token"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TsTextMutedBrush}" />

          <Border Background="{StaticResource TsAccentSoftBrush}"
                  BorderBrush="{StaticResource TsAccentBrush}"
                  BorderThickness="1"
                  Padding="12,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding IssuedCompanyToken}"
                         TextWrapping="Wrap"
                         FontSize="13"
                         Foreground="{StaticResource TsTextBrush}"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Classes="ts-toolbar"
                      Margin="10,0,0,0"
                      Padding="8"
                      Command="{Binding CopyTokenCommand}"
                      ToolTip.Tip="Copy token"
                      VerticalAlignment="Center">
                <Panel>
                  <heroIcons:HeroIcon Type="ClipboardDocument" Kind="Outline" Width="20" Height="20"
                                      Foreground="{StaticResource TsAccentBrush}"
                                      IsVisible="{Binding !TokenCopied}" />
                  <heroIcons:HeroIcon Type="ClipboardDocumentCheck" Kind="Solid" Width="20" Height="20"
                                      Foreground="{StaticResource TsAccentBrush}"
                                      IsVisible="{Binding TokenCopied}" />
                </Panel>
              </Button>
            </Grid>
          </Border>

          <Button Classes="ts-primary"
                  Content="Continue"
                  Command="{Binding ContinueAfterTokenCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Height="42"
                  Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
