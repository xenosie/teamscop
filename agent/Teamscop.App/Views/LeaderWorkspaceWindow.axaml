<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Teamscop.App.Controls"
        xmlns:views="clr-namespace:Teamscop.App.Views"
        x:Class="Teamscop.App.Views.LeaderWorkspaceWindow"
        Title="Teamscop — Team leader"
        Icon="/Assets/teamscop-icon.ico"
        Width="1180" Height="720"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="{StaticResource TsBackgroundBrush}"
        BorderBrush="{StaticResource TsAccentBrush}"
        BorderThickness="1">
  <DockPanel>
    <controls:TsTitleBar DockPanel.Dock="Top" Title="Teamscop · Team leader" />
    <views:RoleWorkspaceView Name="WorkspaceHost" />
  </DockPanel>
</Window>
