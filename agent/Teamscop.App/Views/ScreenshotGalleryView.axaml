<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Teamscop.App.ViewModels"
             x:Class="Teamscop.App.Views.ScreenshotGalleryView"
             x:DataType="vm:ScreenshotGalleryViewModel">

  <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
      <TextBlock Text="Screenshot"
                 FontSize="22"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TsTextBrush}" />
      <TextBlock Text="Period-filtered captures. Click a thumbnail to open the full-screen viewer."
                 FontSize="13"
                 Foreground="{StaticResource TsTextMutedBrush}" />
    </StackPanel>

    <Panel>
      <TextBlock Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ShowError}"
                 Foreground="#B91C1C"
                 FontSize="13"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top" />
      <TextBlock Text="{Binding EmptyMessage}"
                 IsVisible="{Binding ShowEmpty}"
                 Foreground="{StaticResource TsTextMutedBrush}"
                 FontSize="13"
                 VerticalAlignment="Top" />
      <TextBlock Text="Loading…"
                 IsVisible="{Binding IsLoading}"
                 Foreground="{StaticResource TsTextMutedBrush}"
                 FontSize="13"
                 VerticalAlignment="Top" />

      <DockPanel IsVisible="{Binding ShowGrid}" LastChildFill="True">
        <!-- A day of captures is paged, not fetched whole (§15.1) -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,10,0,0"
                    IsVisible="{Binding ShowPaging}">
          <Button Classes="ts-toolbar"
                  Content="Load older captures"
                  MinWidth="160"
                  IsEnabled="{Binding !IsLoadingMore}"
                  Command="{Binding LoadMoreCommand}" />
          <TextBlock Text="{Binding PageLabel}"
                     Classes="ts-muted"
                     FontSize="12"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!--
          A ListBox purely for its VirtualizingStackPanel: only the bands on screen are realised,
          so only their thumbnails are requested. Selection is meaningless — each tile is a button.
        -->
        <ListBox Classes="ts-plain"
                 ItemsSource="{Binding Rows}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.DataTemplates>
            <DataTemplate DataType="{x:Type vm:ScreenshotRowViewModel}">
              <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="6" HorizontalAlignment="Stretch" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ScreenshotTileViewModel">
                    <Button Classes="ts-link"
                            Margin="1"
                            Padding="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top"
                            Command="{Binding OpenCommand}"
                            AttachedToVisualTree="OnTileAttached"
                            DataContextChanged="OnTileDataContextChanged">
                      <Border Background="{StaticResource TsSurfaceBrush}"
                              BorderBrush="{StaticResource TsBorderBrush}"
                              BorderThickness="1"
                              Padding="0">
                        <DockPanel LastChildFill="True">
                          <TextBlock DockPanel.Dock="Bottom"
                                     Text="{Binding TimeLabel}"
                                     FontSize="9"
                                     Margin="2,1"
                                     Foreground="{StaticResource TsTextMutedBrush}"
                                     TextTrimming="CharacterEllipsis" />
                          <Panel Height="72" Background="#EFF6FF">
                            <TextBlock Text="…"
                                       IsVisible="{Binding IsLoadingThumb}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource TsTextMutedBrush}" />
                            <TextBlock Text="!"
                                       IsVisible="{Binding ThumbFailed}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#B91C1C"
                                       FontSize="11" />
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="UniformToFill"
                                   IsVisible="{Binding HasThumbnail}"
                                   Margin="0" />
                          </Panel>
                        </DockPanel>
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </DockPanel>
    </Panel>
  </DockPanel>
</UserControl>
