<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Teamscop.App.ViewModels"
             xmlns:svc="clr-namespace:Teamscop.App.Services"
             x:Class="Teamscop.App.Views.SettingsView"
             x:Name="RootSettings"
             x:DataType="vm:SettingsViewModel"
             Background="{StaticResource TsBackgroundBrush}">

  <ScrollViewer Classes="ts-transparent-scroll"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,20" Spacing="28" MaxWidth="720" HorizontalAlignment="Left">
      <StackPanel Spacing="4">
        <TextBlock Text="Settings"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TsTextBrush}" />
        <TextBlock Text="Company time zone and policeman authorities. Changes sync to staff agents immediately."
                   Classes="ts-muted"
                   FontSize="13"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Company time zone -->
      <StackPanel Spacing="6">
        <TextBlock Text="Company time zone"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TsTextBrush}" />
        <TextBlock Text="One time zone for the whole company. Every screen — tracking, App history, lifecycle — shows company time, never the viewer's local time."
                   Classes="ts-muted"
                   FontSize="13"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="6">
        <TextBlock Text="Current"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TsTextBrush}" />
        <TextBlock Classes="ts-muted" FontSize="13">
          <Run Text="Zone: " />
          <Run Text="{Binding CurrentTimeZoneLabel}" />
        </TextBlock>
        <TextBlock Classes="ts-muted" FontSize="13">
          <Run Text="Company time now: " />
          <Run Text="{Binding CurrentBusinessLocal}" />
        </TextBlock>
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Text="Change time zone"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TsTextBrush}" />
        <TextBlock Text="Pick a zone and save. Staff agents pick it up immediately; stored events are not rewritten, they are simply displayed in the new zone."
                   Classes="ts-muted"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <ComboBox ItemsSource="{Binding TimeZoneOptions}"
                  SelectedItem="{Binding SelectedTimeZone}"
                  MinHeight="40"
                  MaxDropDownHeight="360"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{Binding CanSave}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="svc:TimeZoneOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <Button Classes="ts-primary"
                Content="Save time zone"
                MinWidth="180"
                Height="40"
                HorizontalAlignment="Left"
                Margin="0,4,0,0"
                Command="{Binding SaveTimeZoneCommand}"
                IsEnabled="{Binding CanSave}" />

        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TsAccentBrush}"
                   FontSize="13"
                   IsVisible="{Binding ShowStatus}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#B91C1C"
                   FontSize="13"
                   IsVisible="{Binding ShowError}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Policemen -->
      <Border Height="1" Background="{StaticResource TsBorderBrush}" Opacity="0.6" Margin="0,4,0,0" />

      <StackPanel Spacing="10">
        <StackPanel Spacing="4">
          <TextBlock Text="Policemen &amp; authorities"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TsTextBrush}" />
          <TextBlock Text="Promote staff to policeman and grant authority packages. Packages apply company-wide and sync to their agent immediately via the engine."
                     Classes="ts-muted"
                     FontSize="13"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Button Classes="ts-primary"
                Content="Add policeman"
                MinWidth="160"
                Height="40"
                HorizontalAlignment="Left"
                Command="{Binding AddPolicemanCommand}"
                IsEnabled="{Binding CanSave}" />

        <TextBlock Text="No policemen yet"
                   Classes="ts-muted"
                   FontSize="13"
                   IsVisible="{Binding ShowPoliceEmpty}" />

        <ItemsControl ItemsSource="{Binding Policemen}" IsVisible="{Binding HasPolicemen}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PolicemanRowViewModel">
              <Border BorderBrush="{StaticResource TsBorderBrush}"
                      BorderThickness="0,0,0,1"
                      Padding="0,14">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding Username}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TsTextBrush}" />
                  <ItemsControl ItemsSource="{Binding Packages}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PackageToggleViewModel">
                        <CheckBox Content="{Binding Label}"
                                  IsChecked="{Binding IsEnabled}"
                                  Margin="0,0,16,8"
                                  MinWidth="180" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="ts-primary"
                            Content="Save authorities"
                            MinWidth="150"
                            Height="36"
                            Command="{Binding #RootSettings.((vm:SettingsViewModel)DataContext).SavePolicemanCommand}"
                            CommandParameter="{Binding}" />
                    <Button Classes="ts-toolbar"
                            Content="Revoke"
                            MinWidth="100"
                            Height="36"
                            Command="{Binding #RootSettings.((vm:SettingsViewModel)DataContext).RevokePolicemanCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding PoliceStatusMessage}"
                   Foreground="{StaticResource TsAccentBrush}"
                   FontSize="13"
                   IsVisible="{Binding ShowPoliceStatus}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{Binding PoliceErrorMessage}"
                   Foreground="#B91C1C"
                   FontSize="13"
                   IsVisible="{Binding ShowPoliceError}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
