<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Teamscop.App.Controls"
        x:Class="Teamscop.App.Views.TeamNameDialog"
        Title="New team"
        Icon="/Assets/teamscop-icon.ico"
        Width="380" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="{StaticResource TsSurfaceBrush}"
        BorderBrush="{StaticResource TsAccentBrush}"
        BorderThickness="1">
  <DockPanel>
    <controls:TsTitleBar DockPanel.Dock="Top" Title="New team" />
    <StackPanel Margin="24" Spacing="14">
      <TextBlock Text="Team name"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TsAccentBrush}" />
      <TextBox Name="NameBox"
               Classes="ts-field"
               Watermark="e.g. Sales"
               MinHeight="40" />
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Classes="ts-toolbar" Content="Cancel" Name="BtnCancel" MinWidth="96" Height="40" />
        <Button Classes="ts-primary" Content="Create" Name="BtnCreate" MinWidth="110" Height="40" />
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
