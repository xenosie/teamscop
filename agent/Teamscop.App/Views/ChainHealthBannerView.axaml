<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Teamscop.App.ViewModels"
             x:Class="Teamscop.App.Views.ChainHealthBannerView"
             x:DataType="vm:ChainHealthViewModel">
  <Border IsVisible="{Binding ShowBanner}"
          Background="#FEF2F2"
          BorderBrush="#DC2626"
          BorderThickness="1"
          Padding="10,8"
          Margin="0,0,0,12">
    <TextBlock Text="{Binding BannerMessage}"
               Foreground="#991B1B"
               FontSize="13"
               FontWeight="SemiBold"
               TextWrapping="Wrap" />
  </Border>
</UserControl>
