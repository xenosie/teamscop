<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:heroIcons="clr-namespace:HeroIconsAvalonia.Controls;assembly=HeroIconsAvalonia"
             x:Class="Teamscop.App.Controls.AppToolbar">

  <Border Background="{StaticResource TsSurfaceBrush}"
          BorderBrush="{StaticResource TsBorderBrush}"
          BorderThickness="0,0,0,1"
          Padding="16,10">
    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

      <!-- Brand -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Image Source="/Assets/teamscop-icon.png"
               Width="34" Height="34"
               VerticalAlignment="Center"
               Stretch="Uniform" />
        <TextBlock Classes="ts-brand"
                   Text="Teamscop"
                   VerticalAlignment="Center" />
      </StackPanel>

      <!-- Center nav actions -->
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="4"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Button Classes="ts-toolbar" Name="BtnOrg">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <heroIcons:HeroIcon Type="UserGroup" Kind="Outline" Width="18" Height="18"
                                Foreground="{StaticResource TsAccentBrush}" />
            <TextBlock Text="Teams" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="ts-toolbar" Name="BtnStaff">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <heroIcons:HeroIcon Type="Users" Kind="Outline" Width="18" Height="18"
                                Foreground="{StaticResource TsAccentBrush}" />
            <TextBlock Text="Staff" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="ts-toolbar" Name="BtnPolice">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <heroIcons:HeroIcon Type="FingerPrint" Kind="Outline" Width="18" Height="18"
                                Foreground="{StaticResource TsAccentBrush}" />
            <TextBlock Text="Police" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="ts-toolbar" Name="BtnTracking">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <heroIcons:HeroIcon Type="ChartBarSquare" Kind="Outline" Width="18" Height="18"
                                Foreground="{StaticResource TsAccentBrush}" />
            <TextBlock Text="Tracking" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Right actions -->
      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <Button Classes="ts-toolbar" Name="BtnSearch" ToolTip.Tip="Search">
          <heroIcons:HeroIcon Type="MagnifyingGlassCircle" Kind="Outline" Width="18" Height="18"
                              Foreground="{StaticResource TsAccentBrush}" />
        </Button>
        <Button Classes="ts-toolbar" Name="BtnBell" ToolTip.Tip="Notifications">
          <heroIcons:HeroIcon Type="Bell" Kind="Outline" Width="18" Height="18"
                              Foreground="{StaticResource TsAccentBrush}" />
        </Button>
        <Button Classes="ts-primary" Name="BtnCode" Content="Get code" MinWidth="110" />
        <Border Width="36" Height="36"
                Background="{StaticResource TsAccentSoftBrush}"
                BorderBrush="{StaticResource TsBorderStrongBrush}"
                BorderThickness="1"
                VerticalAlignment="Center"
                ToolTip.Tip="Account">
          <heroIcons:HeroIcon Type="UserCircle" Kind="Solid" Width="22" Height="22"
                              Foreground="{StaticResource TsAccentBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
