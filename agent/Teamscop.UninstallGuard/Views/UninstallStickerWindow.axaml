<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Teamscop.UninstallGuard.Views.UninstallStickerWindow"
        Title="Teamscop"
        Width="280" Height="128"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <Border Name="Chrome"
          Background="#F8FAFC"
          BorderBrush="#2563EB"
          BorderThickness="1"
          CornerRadius="0"
          ClipToBounds="True"
          PointerPressed="OnChromePressed">
    <Grid Margin="12,10" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
      <TextBox Name="CodeBox"
               FontFamily="Segoe UI, Inter, sans-serif"
               FontSize="16"
               Watermark=""
               MaxLength="6"
               HorizontalContentAlignment="Center"
               TextAlignment="Center"
               Padding="8,6"
               MinHeight="36"
               Background="#FFFFFF"
               BorderBrush="#CBD5E1"
               BorderThickness="1"
               CornerRadius="0"
               KeyDown="OnCodeKeyDown" />
      <TextBlock Name="ErrorText"
                 Grid.Row="1"
                 Foreground="#DC2626"
                 FontFamily="Segoe UI, Inter, sans-serif"
                 FontSize="11"
                 TextWrapping="Wrap"
                 IsVisible="False" />
      <Button Name="OkButton"
              Grid.Row="2"
              Content="OK"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              Height="32"
              FontSize="13"
              FontWeight="SemiBold"
              Background="#2563EB"
              Foreground="#FFFFFF"
              BorderThickness="0"
              CornerRadius="0"
              Cursor="Hand"
              Click="OnOkClick" />
    </Grid>
  </Border>
</Window>
