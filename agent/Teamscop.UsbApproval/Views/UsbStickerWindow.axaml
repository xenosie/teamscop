<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Teamscop.UsbApproval.Views.UsbStickerWindow"
        Title="Teamscop USB"
        Width="300" Height="184"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">
  <Border Name="Chrome"
          Background="#F8FAFC"
          BorderBrush="#2563EB"
          BorderThickness="1"
          CornerRadius="0"
          ClipToBounds="True"
          PointerPressed="OnChromePressed">
    <Grid Margin="12,10" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
      <TextBlock Text="USB storage blocked"
                 FontFamily="Segoe UI, Inter, sans-serif"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="#0F172A" />
      <TextBlock Name="DeviceText"
                 Grid.Row="1"
                 FontFamily="Segoe UI, Inter, sans-serif"
                 FontSize="11"
                 Foreground="#475569"
                 TextWrapping="Wrap"
                 Text="Enter the 6-digit code from your admin to use this device." />
      <TextBox Name="CodeBox"
               Grid.Row="2"
               FontFamily="Segoe UI, Inter, sans-serif"
               FontSize="16"
               Watermark="000000"
               MaxLength="6"
               HorizontalContentAlignment="Center"
               TextAlignment="Center"
               Padding="8,6"
               MinHeight="36"
               Background="#FFFFFF"
               BorderBrush="#CBD5E1"
               BorderThickness="1"
               CornerRadius="0"
               KeyDown="OnCodeKeyDown" />
      <TextBlock Name="ErrorText"
                 Grid.Row="3"
                 Foreground="#DC2626"
                 FontFamily="Segoe UI, Inter, sans-serif"
                 FontSize="11"
                 TextWrapping="Wrap"
                 IsVisible="False" />
      <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="8">
        <Button Name="CancelButton"
                Content="Cancel"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Height="32"
                FontSize="13"
                Background="#E2E8F0"
                Foreground="#0F172A"
                BorderThickness="0"
                CornerRadius="0"
                Cursor="Hand"
                Click="OnCancelClick" />
        <Button Name="OkButton"
                Grid.Column="1"
                Content="OK"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Height="32"
                FontSize="13"
                FontWeight="SemiBold"
                Background="#2563EB"
                Foreground="#FFFFFF"
                BorderThickness="0"
                CornerRadius="0"
                Cursor="Hand"
                Click="OnOkClick" />
      </Grid>
    </Grid>
  </Border>
</Window>
